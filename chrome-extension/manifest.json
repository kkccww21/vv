{
  "manifest_version": 3,
  "name": "KVideo DLNA Cast",
  "version": "1.0.0",
  "description": "DLNA投屏扩展，自动发现设备并实现一键投屏",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
